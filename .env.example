# Connexion IMAP chiffrée uniquement. Ne mets pas le mot de passe ici.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=logs@example.com
IMAP_FOLDER=INBOX

# Historique initial : 30 jours. Aucun filtre UNSEEN : les emails lus sont analysés aussi.
INITIAL_LOOKBACK_DAYS=30
POLL_SECONDS=300
MAX_MESSAGES_PER_POLL=500
MAX_MESSAGE_BYTES=20971520
IMAP_TIMEOUT_SECONDS=45

# Journée du bilan local (aucun email envoyé).
TZ=Europe/Zurich

# Interface locale HTTPS. Pour un accès LAN, renseigne les deux adresses réelles.
WEB_BIND_IP=127.0.0.1
WEB_PUBLIC_URL=https://localhost:8448
WEB_PORT=8448
# SMTP / destinataire : réglables ensuite dans l’interface.
REPORT_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_IMAP_CREDENTIALS=false
